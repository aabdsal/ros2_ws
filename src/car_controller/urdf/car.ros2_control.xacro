<?xml version="1.0"?>

<!-- 

 Esto declara que elementos puede controlar ros2_controol
 y que informacion puede leer y escribir de ellos, 
 no es ni el controlador ni decide como se mueve el coche

 -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="GazeboSimSystem" type="system">

        <hardware>
            <plugin>
                gz_ros2_control/GazeboSimSystem
            </plugin>
        </hardware>

        <xacro:macro name="rueda" params="nombre">            
            <joint name="${nombre}">
                <command_interface name="velocity"> <!-- Escribe velocidad-->
                    <param name="min">-15</param>
                    <param name="max">15</param>
                </command_interface>
                <state_interface name="position"/> <!-- Lee posicion y velocidad-->
                <state_interface name="velocity"/>
            </joint>
        </xacro:macro>

        <xacro:rueda nombre="rueda_trasera_izquierda_joint"/>
        <xacro:rueda nombre="rueda_trasera_derecha_joint"/>
        <xacro:rueda nombre="rueda_delantera_izquierda_joint"/>
        <xacro:rueda nombre="rueda_delantera_derecha_joint"/>

    </ros2_control>
</robot>


<launch>
    <node pkg="turtlesim" exec="turtlesim_node" name="turtle1" namespace="/t1">
        <param from="$(find-pkg-share my_robot_bringup)/config/turtle_params.yaml"/>
    </node>
    
    <node pkg="turtlesim" exec="turtlesim_node" name="turtle2" namespace="/t2">
        <param from="$(find-pkg-share my_robot_bringup)/config/turtle_params.yaml"/>
    </node>
    
    <node pkg="turtle_controller_cpp" exec="turtle_controller" 
    name="turtle1_controller" namespace="/t1">
        <param from="$(find-pkg-share my_robot_bringup)/config/turtle_params.yaml"/>
    </node>
    
    <node pkg="turtle_controller_cpp" exec="turtle_controller" 
    name="turtle2_controller" namespace="/t2">
        <param from="$(find-pkg-share my_robot_bringup)/config/turtle_params.yaml"/>
    </node>
</launch>


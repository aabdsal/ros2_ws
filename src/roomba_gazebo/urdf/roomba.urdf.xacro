<?xml version="1.0"?>
<!--
  Roomba simplificada - Clase 2: simulación con Gazebo + ros2_control

  Es lo mismo que hicimos en la clase 1, pero con
  tres añadidos para poder simularlo:

    1. <inertial> en cada link que se mueve (masa + tensor de inercia).
       Sin ellos Gazebo (simulador) no sabe cómo acelera el robot y descarta los links.
    2. Bloque <ros2_control>  -> roomba.ros2_control.xacro
       Qué joints se controlan y por qué interfaz (velocidad, posición...).
    3. Bloque <gazebo>        -> roomba.gazebo.xacro
       El plugin que conecta Gazebo con ros2_control y la fricción.

  Inercias de formas simples (m = masa):
    Cilindro (eje Z, radio r, altura h):
        Ixx = Iyy = m (3 r² + h²) / 12        Izz = m r² / 2
    Esfera (radio r):
        Ixx = Iyy = Izz = 2 m r² / 5
    Caja (lados x, y, z):
        Ixx = m (y² + z²) / 12   Iyy = m (x² + z²) / 12   Izz = m (x² + y²) / 12
-->
<robot name="roomba" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="dark_grey">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.10 0.80 0.30 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.00 0.50 0.00 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <!--  BASE                                                        -->

  <!-- Raíz sin geometría ni inercia. -->
  <link name="base_footprint"/>

  <!-- Base de la roomba -->
  <!-- Observad que se pueden encadenar distintos visuales
       en un mismo link, como se explicó en la 
       anterior clase, para crear formas complejas. -->
  <link name="base_link">
    <visual name="chassis">
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.06"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual name="top_cover">
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.008"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.068"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0.010" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02283" ixy="0.0" ixz="0.0"
               iyy="0.02283" iyz="0.0"
               izz="0.04335"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.036" rpy="0 0 0"/>
  </joint>

  <!--  RUEDAS MOTRICES -->

  <link name="left_wheel_link">
    <visual name="tire">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="marker">
      <origin xyz="0.022 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.022 0.008"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.02"/>
      </geometry>
    </collision>
    <!-- OJO La rueda es un cilindro TUMBADO: su eje de
         giro ya no es Z sino Y. Por eso la inercia "de eje" (la mayor)
         va en iyy y no en izz, como sería en un cilindro de pie. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.573e-5" ixy="0.0" ixz="0.0"
               iyy="6.48e-5" iyz="0.0"
               izz="3.573e-5"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.1175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual name="tire">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="marker">
      <origin xyz="0.022 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.022 0.008"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.573e-5" ixy="0.0" ixz="0.0"
               iyy="6.48e-5" iyz="0.0"
               izz="3.573e-5"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.1175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!--  RUEDA LIBRE                                         -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>
    <!-- Esfera de 0.05 kg, r = 0.018:  I = 2 · 0.05 · 0.018² / 5 = 6.48e-6 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="6.48e-6" ixy="0.0" ixz="0.0"
               iyy="6.48e-6" iyz="0.0"
               izz="6.48e-6"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.13 0 -0.018" rpy="0 0 0"/>
  </joint>

  <!--  CEPILLO LATERAL -->
  <link name="side_brush_link">
    <visual name="hub">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="bristles_a">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.004 0.002"/>
      </geometry>
      <material name="green"/>
    </visual>
    <visual name="bristles_b">
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.12 0.004 0.002"/>
      </geometry>
      <material name="green"/>
    </visual>
    <!-- Sigue sin <collision>, pero ahora NECESITA <inertial> 
         un link unido por un joint móvil y sin masa se descarta en Gazebo. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1.803e-5" ixy="0.0" ixz="0.0"
               iyy="1.803e-5" iyz="0.0"
               izz="3.6e-5"/>
    </inertial>
  </link>

  <joint name="side_brush_joint" type="continuous">
    <parent link="base_link"/>
    <child link="side_brush_link"/>
    <origin xyz="0.12 -0.10 -0.028" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!--  ELEMENTOS FIJOS -->
  <!--  Unidos con joints fixed: Gazebo los fusiona con base_link,  -->
  <!--  así que no necesitan <inertial>. -->
  <link name="bumper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.12 0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_link"/>
    <origin xyz="0.165 0 0.006" rpy="0 0 0"/>
  </joint>

  <link name="clean_button_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.004"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="clean_button_joint" type="fixed">
    <parent link="base_link"/>
    <child link="clean_button_link"/>
    <origin xyz="0 0 0.046" rpy="0 0 0"/>
  </joint>

  <!--  SIMULACIÓN -->
  <!-- Se añaden al documento, las secciones de ros2_control y de Gazebo. -->
  <xacro:include filename="$(find roomba_gazebo)/urdf/roomba.ros2_control.xacro"/>
  <xacro:include filename="$(find roomba_gazebo)/urdf/roomba.gazebo.xacro"/>

</robot>
